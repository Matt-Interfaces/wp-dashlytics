<?xml version="1.0"?>
<ruleset name="Dashlytics">
    <description>WordPress Coding Standards für Dashlytics</description>

    <!-- Alle PHP-Dateien im Plugin-Root prüfen -->
    <file>.</file>

    <!-- Ausschlüsse -->
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/app/*</exclude-pattern>
    <exclude-pattern>*/assets/css/*</exclude-pattern>
    <exclude-pattern>*/includes/plugin-update-checker/*</exclude-pattern>

    <!-- WordPress-Extra Ruleset verwenden -->
    <rule ref="WordPress-Extra" />

    <!-- Output Escaping erzwingen (XSS-Relevanz) -->
    <rule ref="WordPress.Security.EscapeOutput">
        <properties>
            <property name="customAutoEscapedFunctions" value="dashlytics_widget_data" />
        </properties>
    </rule>

    <!-- Nonce-Verification erzwingen -->
    <rule ref="WordPress.Security.NonceVerification" />

    <!-- Nonces/Capability-Checks for ajax hooks -->
    <rule ref="WordPress.Security.ValidatedSanitizedInput" />

    <!-- PHP-Version -->
    <config name="testVersion" value="7.4-" />

    <!-- Zeilenende normalisieren -->
    <arg name="colors" />
    <arg value="sp" />

    <!-- Encoding -->
    <config name="encoding" value="utf-8" />
    <config name="timezone" value="UTC" />
</ruleset>